# ===== Backend (backend/.env, or the repo-root .env for docker compose) =====

# Postgres connection string — OPTIONAL when using `docker compose up`,
# which bundles a local Postgres by default. Uncomment only to use your own
# database (a Supabase pooler URL works as-is). All OpenNIW tables live in a
# dedicated "openniw" schema, so a shared database is never polluted.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT signing secret — REQUIRED. Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
TOKEN_TTL_HOURS=72

# OpenAI — all evaluation/drafting/analysis runs through this. REQUIRED.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=xhigh

# File storage directory (uploads, filled PDFs)
DATA_DIR=./data

# Comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000

# ===== Frontend (frontend/.env.local) =====
# Under docker compose this is passed as a build arg; change it here if you
# serve the backend on a different host/port, then rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8400
