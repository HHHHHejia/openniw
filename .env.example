# ===== Backend (backend/.env or Railway service variables) =====

# Postgres connection string. A Supabase pooler URL works as-is.
# All OpenNIW tables are created inside a dedicated "openniw" schema,
# so a shared database is never polluted.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT signing secret — generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
TOKEN_TTL_HOURS=72

# OpenAI — all evaluation/drafting/analysis runs through this
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=xhigh

# File storage directory (mount a Railway volume here in production)
DATA_DIR=./data

# Comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000

# ===== Frontend (frontend/.env.local or Railway service variables) =====
NEXT_PUBLIC_API_URL=http://localhost:8400
