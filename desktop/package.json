{
  "name": "openniw-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for OpenNIW — runs your own coding agent and the local companion in one window. No accounts, no server, no credential handling.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --dir",
    "pack": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.2.0-beta.15"
  },
  "build": {
    "appId": "com.openniw.desktop",
    "productName": "OpenNIW",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
